---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { posts, formatDate } from '../../data/posts';
import type { Post } from '../../data/posts';

interface Props {
  post: Post;
}

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const url = `https://atlc.cl/blog/${post.slug}/`;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.excerpt,
  image: `https://atlc.cl${post.image}`,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: "es-CL",
  mainEntityOfPage: url,
  author: { "@type": "Organization", name: post.author },
  publisher: { "@id": "https://atlc.cl/#organization" },
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://atlc.cl/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://atlc.cl/blog/" },
    { "@type": "ListItem", position: 3, name: post.title, item: url },
  ],
};
---

<Layout
  title={post.seoTitle}
  description={post.excerpt}
  image={post.image}
  type="article"
  publishedTime={post.date}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <Header />

  <PageHero label="Blog" title={post.title} bgImage="/img/bg-title-5.webp" />

  <article class="post">
    <div class="post-container">
      <p class="post-meta">
        <time datetime={post.date}>{formatDate(post.date)}</time> · {post.author}
      </p>

      {post.body.map((block) => {
        if (block.type === 'h2') return <h2>{block.text}</h2>;
        if (block.type === 'ul') return <ul>{block.items.map((i) => <li>{i}</li>)}</ul>;
        return <p>{block.text}</p>;
      })}

      <div class="post-cta">
        <h2>¿Necesitas asesoría tributaria o de auditoría?</h2>
        <p>Nuestro equipo de expertos está listo para ayudarte.</p>
        <a href="/contacto/" class="btn-primary">CONTÁCTANOS</a>
      </div>

      <p class="post-back"><a href="/blog/">← Volver al blog</a></p>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .post { padding: 70px 0 90px; }
  .post-container { max-width: 760px; margin: 0 auto; padding: 0 20px; }
  .post-meta { color: #1B60AD; font-weight: 600; font-size: .9rem; margin-bottom: 2rem; }
  .post-container h2 { font-size: 1.5rem; color: #142c4b; margin: 2.2rem 0 1rem; line-height: 1.3; }
  .post-container p { line-height: 1.85; color: #414656; margin-bottom: 1.2rem; font-size: 1.05rem; }
  .post-container ul { margin: 0 0 1.5rem 1.4rem; }
  .post-container li { line-height: 1.8; color: #414656; margin-bottom: .6rem; font-size: 1.05rem; }
  .post-cta { margin-top: 3rem; padding: 2.2rem; background: #f8f9fa; border-radius: 8px; text-align: center; }
  .post-cta h2 { margin-top: 0; }
  .post-back { margin-top: 2rem; }
  .post-back a { color: #1B60AD; font-weight: 600; }
</style>
