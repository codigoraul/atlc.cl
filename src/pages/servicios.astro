---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../data/services';
---

<Layout
  title="Servicios Tributarios, de Auditoría y Outsourcing Contable en Santiago | ATLC"
  description="Consultoría y asesoría tributaria, auditoría financiera y outsourcing contable para empresas, pymes y personas en Santiago, Chile."
>
  <Header />

  <PageHero label="ATLC" title="Nuestros Servicios" bgImage="/img/bg-title-3.webp" />

  <section class="services-overview">
    <div class="container">
      <p class="overview-intro">
        Acompañamos a emprendedores, grupos empresariales, empresas familiares, pymes y personas
        en materias tributarias, de auditoría y de contabilidad.
      </p>

      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card animate-on-scroll">
            <img
              src={s.image}
              alt={s.imageAlt}
              width={s.imageWidth}
              height={s.imageHeight}
              loading="lazy"
              decoding="async"
            />
            <div class="service-card-body">
              <h2>{s.title}</h2>
              <p>{s.summary}</p>
              <a href={`/servicios/${s.slug}/`} class="btn-primary">VER SERVICIO</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .services-overview { padding: 80px 0; }
  .overview-intro { text-align: center; max-width: 720px; margin: 0 auto 3.5rem; font-size: 1.1rem; line-height: 1.8; color: #414656; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem; }
  .service-card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.08); display: flex; flex-direction: column; }
  .service-card img { width: 100%; height: 240px; object-fit: cover; display: block; }
  .service-card-body { padding: 1.8rem; display: flex; flex-direction: column; flex: 1; }
  .service-card-body h2 { font-size: 1.3rem; color: #142c4b; margin-bottom: .8rem; }
  .service-card-body p { color: #414656; line-height: 1.7; margin-bottom: 1.5rem; flex: 1; }
  @media (max-width: 768px) { .services-grid { grid-template-columns: 1fr; } }
</style>
