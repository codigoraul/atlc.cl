---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const enviado = Astro.url.searchParams.get('enviado');
const error = Astro.url.searchParams.get('error');
---

<Layout 
  title="Contacto" 
  description="Contáctanos para agendar una reunión con nuestros especialistas."
>
  <Header />
  
  <PageHero 
    label="Vamos a conversar" 
    title="Contacto"
    bgImage="/img/bg-title-4.webp"
  />

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Columna izquierda: Formulario -->
        <div class="contact-form-wrapper animate-on-scroll">
          {enviado === '1' && (
            <div class="alert alert-success">
              ✅ Mensaje enviado exitosamente. Te contactaremos pronto.
            </div>
          )}
          {error === '1' && (
            <div class="alert alert-error">
              ❌ Hubo un error al enviar. Por favor intenta nuevamente.
            </div>
          )}

          <form method="POST" action="/contact.php" class="contact-form">
            <h2>Formulario de contacto</h2>
            <span class="section-label">Vamos a conversar</span>

            <div class="form-group">
              <input type="text" name="nombre" placeholder="Tu Nombre" required />
            </div>
            <div class="form-group">
              <input type="email" name="email" placeholder="Tu Email" required />
            </div>
            <div class="form-group">
              <input type="tel" name="telefono" placeholder="Tu Teléfono" required />
            </div>
            <div class="form-group">
              <textarea name="mensaje" placeholder="Tu Mensaje" rows="6" required></textarea>
            </div>
            <button type="submit" class="btn-primary w-100">Enviar Formulario</button>
          </form>
        </div>

        <!-- Columna derecha: Datos de contacto -->
        <div class="contact-info-wrapper animate-on-scroll">
          <h2>Datos de contacto</h2>
          <span class="section-label">Contáctanos</span>
          <p class="contact-description">
            Nuestro equipo y experiencia queda a tu disposición. Contáctanos y agenda tu reunión, 
            cuéntanos cómo podemos ayudarte.
          </p>

          <div class="contact-info-items">
            <div class="contact-info-item">
              <div class="contact-info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <a href="tel:+56984699275">+56 9 84699275</a>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <a href="mailto:contacto@atlc.cl">contacto@atlc.cl</a>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                Dr. Manuel Barros Borgoño 110<br />
                Oficina 205, Providencia<br />
                Santiago, Chile
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa de Google Maps -->
  <section class="map-section">
    <iframe 
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1738.5858693173072!2d-70.61964541677006!3d-33.42973383534183!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662cf7cd52dd917%3A0x107604284575d865!2sDr.%20Manuel%20Barros%20Borgo%C3%B1o%20110%2C%20Oficina%20205%2C%20Providencia%2C%20Regi%C3%B3n%20Metropolitana!5e0!3m2!1ses!2scl!4v1635366494672!5m2!1ses!2scl"
      width="100%" 
      height="450" 
      style="border:0;" 
      allowfullscreen="" 
      loading="lazy"
      title="Ubicación ATLC"
    ></iframe>
  </section>

  <Footer />
</Layout>

<style>
  .contact-section {
    padding: 80px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-form-wrapper,
  .contact-info-wrapper {
    background: white;
    padding: 2.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .contact-info-wrapper h2,
  .contact-form h2 {
    font-size: 1.5rem;
    color: #142c4b;
    margin-bottom: 0.3rem;
  }

  .contact-description {
    font-size: 1rem;
    line-height: 1.7;
    color: #414656;
    margin-bottom: 2rem;
  }

  .contact-info-items {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .contact-info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-info-icon {
    width: 40px;
    height: 40px;
    background-color: rgba(27, 96, 173, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-info-icon svg {
    width: 20px;
    height: 20px;
    color: #1B60AD;
  }

  .contact-info-item a {
    color: #414656;
    font-size: 1rem;
    transition: color 0.2s ease;
  }

  .contact-info-item a:hover {
    color: #1B60AD;
  }

  .contact-info-item div {
    font-size: 1rem;
    color: #414656;
    line-height: 1.6;
  }

  .map-section {
    width: 100%;
  }

  .map-section iframe {
    display: block;
    width: 100%;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form-wrapper,
    .contact-info-wrapper {
      padding: 1.5rem;
    }
  }
</style>
