---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  bgImage?: string;
}
const { label, title, subtitle, bgImage } = Astro.props;
---

<section class="page-hero" style={bgImage ? `background-image: url('${bgImage}')` : ''}>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <span class="section-label">{label}</span>
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, #142c4b 0%, #1B60AD 100%);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: white;
    padding: 80px 0;
    text-align: center;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(20, 44, 75, 0.7);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .page-hero .section-label {
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 600;
    color: white;
    margin-bottom: 0.2rem;
    letter-spacing: .05rem;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 600px;
    margin: 0 auto;
  }
</style>
